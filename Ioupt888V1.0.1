-- หมวดหมู่ที่ 3: เมนูผู้เล่น & ระบบจุดวาป (Player & Teleport)
--------------------------------------------------------------------------------
local TabPlayer = Window:CreateTab("Player & Teleport", 4483362458)

TabPlayer:CreateSection("ระบบวาร์ป (Teleport Manager)")

TabPlayer:CreateInput({
   Name = "ตั้งชื่อจุดวาป",
   PlaceholderText = "พิมพ์ชื่อจุดวาปที่นี่...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      WarpNameInput = Text
   end,
})

TabPlayer:CreateButton({
   Name = "📍 บันทึกจุดวาปปัจจุบัน",
   Callback = function()
      local name = WarpNameInput:gsub("^%s*(.-)%s*$", "%1")
      if name == "" then
         name = "จุดวาป_" .. tostring(#SavedPositions + 1)
      end

      -- เช็คชื่อซ้ำ
      for _, warp in ipairs(SavedPositions) do
         if warp.Name == name then
            Rayfield:Notify({
               Title = "แจ้งเตือน",
               Content = "ชื่อจุดวาปนี้มีอยู่แล้ว!",
               Duration = 2,
               Image = 4483362458,
            })
            return
         end
      end

      local char = LocalPlayer.Character
      local hrp = char and char:FindFirstChild("HumanoidRootPart")

      if hrp then
         local savedCFrame = hrp.CFrame
         local warpData = { Name = name, CFrame = savedCFrame }
         table.insert(SavedPositions, warpData)

         -- สร้างปุ่มวาป
         local warpBtn
         warpBtn = TabPlayer:CreateButton({
            Name = "🚀 วาปไป: " .. name,
            Callback = function()
               local c = LocalPlayer.Character
               local root = c and c:FindFirstChild("HumanoidRootPart")
               if root then
                  root.CFrame = savedCFrame
               end
            end,
         })

         -- สร้างปุ่มลบจุดวาป
         local delBtn
         delBtn = TabPlayer:CreateButton({
            Name = "❌ ลบจุดวาป: " .. name,
            Callback = function()
               -- ลบออกจากตาราง
               for i, v in ipairs(SavedPositions) do
                  if v.Name == name then
                     table.remove(SavedPositions, i)
                     break
                  end
               end
               -- ซ่อนปุ่มออกจาก UI
               if warpBtn then warpBtn:Destroy() end
               if delBtn then delBtn:Destroy() end

               Rayfield:Notify({
                  Title = "Teleport",
                  Content = "ลบจุดวาป " .. name .. " เรียบร้อยแล้ว",
                  Duration = 2,
                  Image = 4483362458,
               })
            end,
         })

         Rayfield:Notify({
            Title = "Teleport",
            Content = "บันทึกจุดวาป: " .. name .. " สำเร็จ!",
            Duration = 2,
            Image = 4483362458,
         })
      end
   end,
})

TabPlayer:CreateSection("ระบบป้องกัน")

TabPlayer:CreateToggle({
   Name = "ระบบกันตาย (Godmode)",
   CurrentValue = false,
   Callback = function(Value)
      PlayerSettings.Godmode = Value
   end,
})

TabPlayer:CreateSection("ปรับแต่งตัวละคร")

TabPlayer:CreateSlider({
