-- หมวดหมู่ที่ 5: ยานพาหนะ และ แมพ (Boat & Utility)
--------------------------------------------------------------------------------
local TabUtility = Window:CreateTab("Utility & World", 4483362458)

TabUtility:CreateSection("ระบบเรือและการสัญจร")

TabUtility:CreateToggle({
   Name = "เปิดใช้งาน Boat Speed",
   CurrentValue = false,
   Flag = "BoatSpeedToggle",
   Callback = function(Value)
      BOAT_ENABLED = Value
      if BOAT_ENABLED then
         if boatConnection then boatConnection:Disconnect() end
         boatConnection = RunService.Heartbeat:Connect(function()
            local seat = getSeat()
            if seat then
               seat.MaxSpeed = SPEED
               seat.Torque = SPEED * 8
               if seat.Occupant and seat.Throttle ~= 0 then
                  seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (SPEED * seat.Throttle)
               end
            end
         end)
      else
         if boatConnection then
            boatConnection:Disconnect()
            boatConnection = nil
         end
      end
   end,
})

TabUtility:CreateSlider({
   Name = "ปรับความเร็วเรือ (Speed)",
   Range = {50, 300},
   Increment = 10,
   Suffix = " Speed",
   CurrentValue = 130,
   Flag = "BoatSpeedSlider",
   Callback = function(Value)
      SPEED = Value
   end,
})

TabUtility:CreateToggle({
   Name = "เปิดใช้งาน เดินบนน้ำ (Water Walk)",
   CurrentValue = false,
   Flag = "WaterWalkToggle",
   Callback = function(Value)
      WATER_WALK_ENABLED = Value
      
      if WATER_WALK_ENABLED then
         if not waterPart then
            waterPart = Instance.new("Part")
            waterPart.Size = Vector3.new(10, 1, 10)
            waterPart.Transparency = 1
            waterPart.Anchored = true
            waterPart.CanCollide = true
            waterPart.Name = "WaterWalkPlatform"
            waterPart.Parent = workspace
         end

         if waterWalkConnection then waterWalkConnection:Disconnect() end
         waterWalkConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
               local hrp = char.HumanoidRootPart
               if hrp.Position.Y <= 3 then
                  waterPart.Position = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
                  waterPart.CanCollide = true
               else
                  waterPart.CanCollide = false
               end
            end
         end)
      else
         if waterWalkConnection then
            waterWalkConnection:Disconnect()
            waterWalkConnection = nil
         end
         if waterPart then
            waterPart:Destroy()
            waterPart = nil
         end
      end
   end,
})

TabUtility:CreateSection("ระบบปรับแต่งบรรยากาศ")

TabUtility:CreateToggle({
   Name = "เปิดใช้งาน ล็อกเวลาเช้า (Always Morning)",
   CurrentValue = false,
   Flag = "AlwaysMorningToggle",
   Callback = function(Value)
      MORNING_ENABLED = Value
      if MORNING_ENABLED then
         Lighting.ClockTime = MORNING_TIME
         if morningConnection then morningConnection:Disconnect() end
         morningConnection = RunService.RenderStepped:Connect(function()
            if Lighting.ClockTime ~= MORNING_TIME then
               Lighting.ClockTime = MORNING_TIME
            end
         end)
      else
         if morningConnection then
            morningConnection:Disconnect()
            morningConnection = nil
         end
      end
   end,
})

