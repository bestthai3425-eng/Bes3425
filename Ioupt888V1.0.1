-- หมวดหมู่ที่ 4: การเดินอัตโนมัติ (Auto Walk)
--------------------------------------------------------------------------------
local TabAutoWalk = Window:CreateTab("การเดินอัตโนมัติ", 4483362458)

TabAutoWalk:CreateSection("ระบบบันทึกและเดินอัตโนมัติ")

TabAutoWalk:CreateToggle({
   Name = "🔴 บันทึกการเดิน (Record Path)",
   CurrentValue = false,
   Flag = "RecordToggle",
   Callback = function(Value)
      IsRecording = Value
      if IsRecording then
         Waypoints = {}
         Rayfield:Notify({
            Title = "Path Recorder",
            Content = "เริ่มบันทึกเส้นทางแล้ว...",
            Duration = 2,
            Image = 4483362458,
         })
         
         task.spawn(function()
            while IsRecording do
               local char = LocalPlayer.Character
               if char and char:FindFirstChild("HumanoidRootPart") then
                  table.insert(Waypoints, char.HumanoidRootPart.Position)
               end
               task.wait(0.3)
            end
         end)
      else
         Rayfield:Notify({
            Title = "Path Recorder",
            Content = "หยุดบันทึก! ได้จุดเดินทั้งหมด " .. #Waypoints .. " จุด",
            Duration = 3,
            Image = 4483362458,
         })
      end
   end,
})

TabAutoWalk:CreateToggle({
   Name = "▶️ เดินตามเส้นทางอัตโนมัติ (Auto Walk Loop)",
   CurrentValue = false,
   Flag = "PlayToggle",
   Callback = function(Value)
      IsPlaying = Value
      if IsPlaying then
         if #Waypoints == 0 then
            Rayfield:Notify({
               Title = "Warning",
               Content = "ยังไม่มีจุดเดินที่บันทึกไว้!",
               Duration = 3,
               Image = 4483362458,
            })
            return
         end

         Rayfield:Notify({
            Title = "Auto Walk",
            Content = "เริ่มเดินตามจุดที่บันทึกไว้...",
            Duration = 2,
            Image = 4483362458,
         })

         task.spawn(function()
            while IsPlaying do
               for _, point in ipairs(Waypoints) do
                  if not IsPlaying then break end
                  
                  local char = LocalPlayer.Character
                  if char and char:FindFirstChild("Humanoid") then
                     local humanoid = char.Humanoid
                     humanoid:MoveTo(point)
                     humanoid.MoveToFinished:Wait(5)
                  end
               end
               task.wait(0.1)
            end
         end)
      else
         local char = LocalPlayer.Character
         if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            char.Humanoid:MoveTo(char.HumanoidRootPart.Position)
         end
      end
   end,
})

TabAutoWalk:CreateButton({
   Name = "🗑️ ลบข้อมูลจุดเดินทั้งหมด",
   Callback = function()
      Waypoints = {}
      Rayfield:Notify({
         Title = "Path Recorder",
         Content = "ล้างข้อมูลเส้นทางเรียบร้อยแล้ว",
         Duration = 2,
         Image = 4483362458,
      })
   end,
})

