   end,
})

TabHitbox:CreateSlider({
   Name = "ความโปร่งใส (Transparency)",
   Range = {0, 1},
   Increment = 0.1,
   Suffix = "",
   CurrentValue = 0.5,
   Callback = function(Value)
      HitboxSettings.Transparency = Value
   end,
})

RunService.RenderStepped:Connect(function()
   if HitboxSettings.PlayerEnabled then
      for _, player in pairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            hrp.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
            hrp.Transparency = HitboxSettings.Transparency
            hrp.BrickColor = BrickColor.new("Really blue")
            hrp.Material = Enum.Material.Forcefield
            hrp.CanCollide = false
         end
      end
   end

   if HitboxSettings.MobEnabled then
      for _, obj in pairs(workspace:GetChildren()) do
         if obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hrp then
               hrp.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
               hrp.Transparency = HitboxSettings.Transparency
               hrp.BrickColor = BrickColor.new("Really red")
               hrp.Material = Enum.Material.Forcefield
               hrp.CanCollide = false
            end
         end
      end
   end
end)

