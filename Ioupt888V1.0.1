   end,
})

TabESP:CreateToggle({
   Name = "ESP ไอเทม (สีเหลือง)",
   CurrentValue = false,
   Callback = function(Value)
      ESPSettings.Items = Value
   end,
})

local function CreateHighlight(target, color, name)
   if not target:FindFirstChild(name) then
      local highlight = Instance.new("Highlight")
      highlight.Name = name
      highlight.FillColor = color
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.FillTransparency = 0.5
      highlight.OutlineTransparency = 0
      highlight.Parent = target
   end
end

local function RemoveHighlight(target, name)
   if target:FindFirstChild(name) then
      target[name]:Destroy()
   end
end

RunService.RenderStepped:Connect(function()
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character then
         if ESPSettings.Players then
            CreateHighlight(player.Character, Color3.fromRGB(0, 255, 0), "PlayerESP")
         else
            RemoveHighlight(player.Character, "PlayerESP")
         end
      end
   end

   for _, obj in pairs(workspace:GetChildren()) do
      if obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
         if ESPSettings.Mobs then
            CreateHighlight(obj, Color3.fromRGB(255, 0, 0), "MobESP")
         else
            RemoveHighlight(obj, "MobESP")
         end
      end
   end

   for _, obj in pairs(workspace:GetChildren()) do
      if obj:IsA("Tool") or obj:IsA("Handle") then
         if ESPSettings.Items then
            CreateHighlight(obj, Color3.fromRGB(255, 255, 0), "ItemESP")
         else
            RemoveHighlight(obj, "ItemESP")
         end
      end
   end
end)

