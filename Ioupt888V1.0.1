-- หมวดหมู่ที่ 1: Hitbox Expansion
--------------------------------------------------------------------------------
local TabHitbox = Window:CreateTab("Hitbox", 4483362458)

TabHitbox:CreateSection("ตั้งค่า Hitbox")

local function ResetPlayerHitboxes()
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = player.Character.HumanoidRootPart
         hrp.Size = Vector3.new(1.5, 2, 1.2)
         hrp.Transparency = 1
         hrp.BrickColor = BrickColor.new("Medium stone grey")
         hrp.Material = Enum.Material.SmoothPlastic
         hrp.CanCollide = false
      end
   end
end

local function ResetMobHitboxes()
   for _, obj in pairs(workspace:GetChildren()) do
      if obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
         local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
         if hrp then
            hrp.Size = Vector3.new(1.5, 2, 1.2)
            hrp.Transparency = 1
            hrp.BrickColor = BrickColor.new("Medium stone grey")
            hrp.Material = Enum.Material.SmoothPlastic
            hrp.CanCollide = false
         end
      end
   end
end

TabHitbox:CreateToggle({
   Name = "ขยาย Hitbox ผู้เล่นทุกคน",
   CurrentValue = false,
   Callback = function(Value)
      HitboxSettings.PlayerEnabled = Value
      if not Value then
         ResetPlayerHitboxes()
      end
   end,
})

TabHitbox:CreateToggle({
   Name = "ขยาย Hitbox มอนสเตอร์ทุกตัว",
   CurrentValue = false,
   Callback = function(Value)
      HitboxSettings.MobEnabled = Value
      if not Value then
         ResetMobHitboxes()
      end
   end,
})

TabHitbox:CreateSlider({
   Name = "ขนาด Hitbox",
   Range = {2, 50},
   Increment = 1,
   Suffix = " Studs",
   CurrentValue = 10,
   Callback = function(Value)
